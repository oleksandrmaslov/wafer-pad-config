CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y
CONFIG_GPIO=y
CONFIG_PINCTRL=y

# Adafruit nRF52 UF2 bootloader (MBR + S140 v6.1.1 kept in 0x0-0x26000):
# link the application at zephyr,code-partition (0x26000) and emit a .uf2.
CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_BUILD_OUTPUT_HEX=y
CONFIG_BUILD_OUTPUT_UF2=y
